# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# 仮想環境
.venv/
venv/
env/
ENV/

# キャッシュ・中間生成物
# 生データJSON（cases_list / case_* / updates_* / corpus*）はGitHubで閲覧できるよう追跡する
# 派生バイナリ（埋め込み・TF-IDF等のpickle）は大きく再生成可能なので除外
cache/*.pkl
*.cache

# 結果ファイル（HTMLレポート・解析結果は追跡する）
# Artifact公開用の派生HTML（本体レポートの重複なので除外）
plan01/results/report_artifact.html

# plan02: 中間成果物の派生バイナリは除外（JSON結果・レポートは追跡）
plan02/features/*.npz
plan02/features/*.pkl

# plan04: 同上（plan02からコピーした派生バイナリも追跡しない）
plan04/features/*.npz
plan04/features/*.pkl

# Jupyter
.ipynb_checkpoints/
*.ipynb

# 環境変数・シークレット
.env
.env.*
secrets.json

# MCP設定（APIキーなどが含まれる場合）
.mcp.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# エディタ
.vscode/
.idea/
*.swp
*.swo
*~

# ログ
*.log
logs/

# タグ確認・タグ割合の「記入済み」ファイル（確認者名とコメントが入るため追跡しない。
# このリポジトリは GitHub Pages のために公開している）
tag_review/out/reviewed.csv
tag_review/out/reviewed_tags.json
tag_ratio/out/reviewed_ratios.csv
tag_ratio/out/soft_tags_final.json
# フェーズ1の申し送り（確認者のメモ）を持ち回るので、これらも追跡しない
tag_ratio/out/cases_reviewed.json
tag_ratio/out/ratio_review.csv

# Canvaパネルの書き出し（133MB。再書き出しできるので追跡しない）
canva_check/pages/
canva_check/*.zip

# 記入済みシートのダウンロード（ファイル名はGoogleが付けたまま置かれることがある）
tag_review/out/*確認*.csv
tag_ratio/out/*確認*.csv
# 確認者のコメントを本文に埋め込んでいるレポート（公開リポジトリなので追跡しない）
tag_ratio/report/
